{
  "manifest_version":3,
  "name": "YT bookmarker",
  "version":"1.0",
  "description":"an extension that helps you to save timestamps of YT videos",
  "permissions":["storage", "tabs", "scripting", "sidePanel"],
  "host_permissions":["https://www.youtube.com/*", "http://localhost:8787/*"],
  "background":{
    "service_worker":"background.js"
  },
  "content_scripts":[
    {
      "matches":["https://www.youtube.com/*"], 
      "js":["contentScript.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/bookmark.png",
        "assets/play.png",
        "assets/delete.png",
        "assets/save.png"
      ],
      "matches": ["https://*.youtube.com/*"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "assets/ext-icon.png",
      "24": "assets/ext-icon.png",
      "32": "assets/ext-icon.png"
    },
    "default_title":"YT bookmarker"
  },
  "commands": {
    "add-bookmark": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Add a bookmark to the actual timestamp"
    }
  }

}